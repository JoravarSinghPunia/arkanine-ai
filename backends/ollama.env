# Laptop or Mac demo tier: Ollama running on the host, serving chat and embeddings.
# Use with `make dev BACKEND=ollama`. See docs/models.md.
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
