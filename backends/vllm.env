# Single GPU pilot tier: two vLLM servers on the host, one per model.
# Use with `make dev BACKEND=vllm`, with INFERENCE_API_KEY set in your shell to the key the
# servers were started with. See docs/models.md.
INFERENCE_BASE_URL=http://host.docker.internal:8001/v1
INFERENCE_MODEL=mistralai/Mistral-Small-3.1-24B-Instruct-2503
EMBEDDING_BASE_URL=http://host.docker.internal:8002/v1
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
