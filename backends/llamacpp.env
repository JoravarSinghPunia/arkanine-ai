# Laptop or Mac demo tier: two llama.cpp servers on the host, one per model.
# Use with `make dev BACKEND=llamacpp`. See docs/models.md.
INFERENCE_BASE_URL=http://host.docker.internal:8081/v1
INFERENCE_MODEL=llama-3.2-3b-instruct
EMBEDDING_BASE_URL=http://host.docker.internal:8082/v1
EMBEDDING_MODEL=nomic-embed-text-v1.5
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
